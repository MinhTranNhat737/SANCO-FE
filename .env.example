# Empty uses the same-origin Vite/nginx proxy; recommended for cookie authentication.
# Vercel static deployments have NO API/Socket.IO proxy in vercel.json.
# On Vercel set this to the separate HTTPS backend origin (without /api).
# Configure FRONTEND_ORIGIN and secure cookies on that backend as well.
VITE_API_URL=
# Public HTTPS origin used in canonical URLs, social cards and sitemap.xml.
# SITE_URL=https://your-domain.example
# Optional trusted local HTTPS certificate for Facebook Login testing.
# DEV_HTTPS_KEY=.certs/localhost-key.pem
# DEV_HTTPS_CERT=.certs/localhost.pem
